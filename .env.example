# Firebase Admin SDK — server-side rendering of public property pages.
# Use the dedicated `clearrent-web-ssr@clearrent-app.iam.gserviceaccount.com`
# account (roles/datastore.user, Firestore only). Do NOT reuse
# clearrent/functions/serviceAccountKey.json — it carries Auth and Storage admin.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK — landlord sign-in and listing creation only.
# Public browse never touches these; it is server-rendered above.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — same cloud and unsigned preset the Flutter app uploads to, so
# both surfaces produce identical image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Public
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_APP_URL=

# Waitlist notification emails
RESEND_API_KEY=

# App Check
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Web Push certificate for push notifications (public).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
